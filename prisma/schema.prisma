generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  firstName          String
  lastName           String
  email              String              @unique
  passwordHash       String
  role               UserRole            @default(USER)
  subscriptionPlan   SubscriptionPlan    @default(FREE)
  isVerified         Boolean             @default(false)
  trialExpiresAt     DateTime?
  nextBillingDate    DateTime?
  resetToken         String?
  resetTokenExpiry   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  verifyToken        String?
  verifyTokenExpiry  DateTime?
  phone              String              @default("")
  gender             Genders             @default(MALE)
  stripeCustomerId   String?             @unique
  subscriptionStatus String?             @default("INACTIVE")
  subscriptionId     String?             @unique
  subscriptionEndsAt DateTime?
  dodoCustomerId     String?             @unique
  attempts           Attempt[]
  fullTestSessions   FullTestSession[]
  payments           Payment[]
  practices          Practice[]
  smartMemories      SmartMemory[]
  subscriptions      Subscription[]
  mathModuleSessions MathModuleSession[]
  rwModuleSessions   RwModuleSession[]
  sessions           UserSession[]
}

model UserSession {
  id            String    @id @default(cuid())
  userId        String
  deviceName    String?
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model QuestionBank {
  id             String                @id @default(cuid())
  title          String
  version        String?
  description    String?
  generatedAt    DateTime?
  sourceFileName String?
  totalQuestions Int                   @default(0)
  purpose        BankPurpose           @default(MIXED)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  sections       QuestionBankSection[]

  @@index([purpose])
}

model QuestionBankSection {
  id      String               @id @default(cuid())
  key     String
  title   String?
  subject Subject?
  order   Int
  bankId  String
  bank    QuestionBank         @relation(fields: [bankId], references: [id], onDelete: Cascade)
  modules QuestionBankModule[]

  @@unique([bankId, key])
  @@index([bankId, order])
}

model QuestionBankModule {
  id         String              @id @default(cuid())
  key        String
  title      String?
  passage    String?
  imageUrl   String?
  audioUrl   String?
  order      Int
  sectionId  String
  difficulty Difficulty?
  section    QuestionBankSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@unique([sectionId, key])
  @@index([sectionId, order])
  @@index([difficulty])
}

model Exam {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  version            String?
  duration           Int
  totalQuestions     Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  Attempt            Attempt[]
  sections           ExamSection[]
  testSessions       FullTestSession[]
  Section            Section[]
  mathModuleSessions MathModuleSession[]
  rwModuleSessions   RwModuleSession[]
}

model ExamSection {
  id                        String                     @id @default(cuid())
  examId                    String
  subject                   Subject
  title                     String
  order                     Int
  duration                  Int
  breakAfter                Int?
  moduleNumber              Int                        @default(1)
  variant                   String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  questions                 ExamQuestion[]
  exam                      Exam                       @relation(fields: [examId], references: [id], onDelete: Cascade)
  sessions                  FullTestSectionSession[]
  mathModuleSectionSessions MathModuleSectionSession[]
  rwModuleSectionSessions   RwModuleSectionSession[]

  @@unique([examId, order])
  @@index([examId])
  @@index([examId, subject, moduleNumber])
}

model FullTestSession {
  id                  String                   @id @default(cuid())
  userId              String
  examId              String
  status              FullTestStatus           @default(IN_PROGRESS)
  currentSectionOrder Int                      @default(1)
  startedAt           DateTime                 @default(now())
  completedAt         DateTime?
  totalTimeSpent      Int?
  expiresAt           DateTime?
  lastActivityAt      DateTime                 @default(now())
  rawScore            Int?
  scaledScore         Int?
  totalCorrect        Int?
  totalSkipped        Int?
  totalWrong          Int?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  sections            FullTestSectionSession[]
  exam                Exam                     @relation(fields: [examId], references: [id])
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([examId])
  @@index([userId, startedAt])
}

model FullTestSectionSession {
  id                String                @id @default(cuid())
  fullTestSessionId String
  examSectionId     String
  status            FullTestSectionStatus @default(NOT_STARTED)
  startedAt         DateTime?
  completedAt       DateTime?
  timeSpent         Int                   @default(0)
  remainingTime     Int?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  lastActivityAt    DateTime              @default(now())
  answers           FullTestAnswer[]
  examSection       ExamSection           @relation(fields: [examSectionId], references: [id])
  fullTestSession   FullTestSession       @relation(fields: [fullTestSessionId], references: [id], onDelete: Cascade)

  @@unique([fullTestSessionId, examSectionId])
  @@index([fullTestSessionId])
  @@index([status])
}

model FullTestAnswer {
  id                       String                 @id @default(cuid())
  fullTestSectionSessionId String
  questionId               String
  selectedOptionId         String?
  textAnswer               String?
  isCorrect                Boolean?
  timeSpent                Int                    @default(0)
  isFlagged                Boolean                @default(false)
  answeredAt               DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  fullTestSectionSession   FullTestSectionSession @relation(fields: [fullTestSectionSessionId], references: [id], onDelete: Cascade)
  question                 Question               @relation(fields: [questionId], references: [id])
  selectedOption           Option?                @relation(fields: [selectedOptionId], references: [id])

  @@unique([fullTestSectionSessionId, questionId])
  @@index([fullTestSectionSessionId])
  @@index([questionId])
  @@index([fullTestSectionSessionId, isCorrect])
}

model ExamQuestion {
  id            String      @id @default(cuid())
  examSectionId String
  questionId    String
  order         Int
  createdAt     DateTime    @default(now())
  examSection   ExamSection @relation(fields: [examSectionId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id])

  @@unique([examSectionId, order])
  @@unique([examSectionId, questionId])
  @@index([examSectionId])
}

model Section {
  id     String          @id @default(cuid())
  title  String
  order  Int
  examId String
  groups QuestionGroup[]
  exam   Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model QuestionGroup {
  id        String     @id @default(cuid())
  title     String?
  passage   String?
  imageUrl  String?
  audioUrl  String?
  order     Int
  sectionId String
  questions Question[]
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Question {
  id                String              @id @default(cuid())
  externalId        String?             @unique
  prompt            String
  domain            String?
  subtopic          String?
  difficulty        Difficulty          @default(MEDIUM)
  type              QuestionType
  correctAnswer     String?
  correctTextAnswer String?
  explanation       String?
  order             Int
  bankPurpose       BankPurpose?
  bankModuleId      String?
  groupId           String?
  passage           String?
  ExamQuestion      ExamQuestion[]
  FullTestAnswer    FullTestAnswer[]
  options           Option[]
  practiceAnswers   PracticeAnswer[]
  bankModule        QuestionBankModule? @relation(fields: [bankModuleId], references: [id])
  group             QuestionGroup?      @relation(fields: [groupId], references: [id])
  smartMemories     SmartMemory[]
  answers           UserAnswer[]
  mathModuleAnswers MathModuleAnswer[]
  rwModuleAnswers   RwModuleAnswer[]

  @@index([bankModuleId, order])
  @@index([domain, subtopic])
  @@index([difficulty])
  @@index([bankPurpose, difficulty])
  @@index([bankPurpose, domain, subtopic])
}

model Option {
  id                String             @id @default(cuid())
  label             String
  content           String
  isCorrect         Boolean            @default(false)
  questionId        String
  FullTestAnswer    FullTestAnswer[]
  question          Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  practiceAnswers   PracticeAnswer[]
  userAnswers       UserAnswer[]
  mathModuleAnswers MathModuleAnswer[]
  rwModuleAnswers   RwModuleAnswer[]
}

model Practice {
  id                String           @id @default(cuid())
  userId            String
  subject           Subject
  domain            String?
  subtopic          String?
  totalQuestions    Int
  correctAnswers    Int              @default(0)
  score             Int?
  timeSpent         Int?
  startedAt         DateTime         @default(now())
  completedAt       DateTime?
  answeredQuestions Int              @default(0)
  difficulty        Difficulty?
  mode              PracticeMode
  status            PracticeStatus   @default(IN_PROGRESS)
  parentPracticeId  String?
  parentPractice    Practice?        @relation("PracticeRetry", fields: [parentPracticeId], references: [id])
  retries           Practice[]       @relation("PracticeRetry")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers           PracticeAnswer[]

  @@index([userId])
  @@index([subject])
  @@index([parentPracticeId])
}

model PracticeAnswer {
  id               String   @id @default(cuid())
  practiceId       String
  questionId       String
  selectedOptionId String?
  textAnswer       String?
  isCorrect        Boolean?
  timeSpent        Int      @default(0)
  practice         Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   Option?  @relation(fields: [selectedOptionId], references: [id])

  @@unique([practiceId, questionId])
  @@index([practiceId])
}

model Attempt {
  id             String       @id @default(cuid())
  userId         String
  examId         String
  score          Int?
  correctAnswers Int?
  startedAt      DateTime     @default(now())
  submittedAt    DateTime?
  status         AttempStatus @default(IN_PROGRESS)
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers        UserAnswer[]
}

model UserAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  textAnswer       String?
  isCorrect        Boolean?
  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   Option?  @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  plan                 SubscriptionPlan
  createdAt            DateTime           @default(now())
  stripeSubscriptionId String?            @unique
  dodoSubscriptionId   String?            @unique
  cancelAtPeriodEnd    Boolean            @default(false)
  currentPeriodEnd     DateTime?
  currentPeriodStart   DateTime?
  status               SubscriptionStatus
  updatedAt            DateTime           @updatedAt
  payments             Payment[]
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Payment {
  id                 String           @id @default(cuid())
  userId             String
  amount             Int
  currency           String           @default("USD")
  status             PaymentStatus    @default(PENDING)
  plan               SubscriptionPlan
  metadata           Json?
  paidAt             DateTime?
  createdAt          DateTime         @default(now())
  cardBrand          String?
  cardLast4          String?
  receiptUrl         String?
  dodoPaymentId      String?          @unique
  dodoSubscriptionId String?
  dodoCustomerId     String?
  dodoInvoiceId      String?          @unique
  dodoRefundId       String?
  subscriptionId     String?
  updatedAt          DateTime         @updatedAt
  subscription       Subscription?    @relation(fields: [subscriptionId], references: [id])
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
  @@index([dodoPaymentId])
  @@index([dodoSubscriptionId])
}

model SmartMemory {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

model MathModuleSession {
  id                  String                  @id @default(cuid())
  userId              String
  examId              String
  status              MathModuleSessionStatus @default(IN_PROGRESS)
  currentSectionOrder Int                     @default(1)
  startedAt           DateTime                @default(now())
  completedAt         DateTime?
  expiresAt           DateTime?
  lastActivityAt      DateTime                @default(now())
  timeSpent           Int                     @default(0)
  totalCorrect        Int?
  totalSkipped        Int?
  totalWrong          Int?
  rawScore            Int?
  scaledScore         Int?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  user     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     Exam                       @relation(fields: [examId], references: [id], onDelete: Cascade)
  sections MathModuleSectionSession[]

  @@index([userId, status])
  @@index([examId])
  @@index([userId, startedAt])
}

model MathModuleSectionSession {
  id                  String               @id @default(cuid())
  mathModuleSessionId String
  examSectionId       String
  status              SectionSessionStatus @default(NOT_STARTED)
  startedAt           DateTime?
  completedAt         DateTime?
  timeSpent           Int                  @default(0)
  remainingTime       Int?
  lastActivityAt      DateTime             @default(now())

  mathModuleSession MathModuleSession  @relation(fields: [mathModuleSessionId], references: [id], onDelete: Cascade)
  examSection       ExamSection        @relation(fields: [examSectionId], references: [id], onDelete: Cascade)
  answers           MathModuleAnswer[]

  @@unique([mathModuleSessionId, examSectionId])
  @@index([mathModuleSessionId])
  @@index([examSectionId])
}

model MathModuleAnswer {
  id                         String    @id @default(cuid())
  mathModuleSectionSessionId String
  questionId                 String
  selectedOptionId           String?
  textAnswer                 String?
  isCorrect                  Boolean?
  timeSpent                  Int       @default(0)
  isFlagged                  Boolean   @default(false)
  answeredAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  mathModuleSectionSession MathModuleSectionSession @relation(fields: [mathModuleSectionSessionId], references: [id], onDelete: Cascade)
  question                 Question                 @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption           Option?                  @relation(fields: [selectedOptionId], references: [id])

  @@unique([mathModuleSectionSessionId, questionId])
  @@index([mathModuleSectionSessionId])
  @@index([questionId])
}

model RwModuleSession {
  id                  String                @id @default(cuid())
  userId              String
  examId              String
  status              RwModuleSessionStatus @default(IN_PROGRESS)
  currentSectionOrder Int                   @default(1)
  startedAt           DateTime              @default(now())
  completedAt         DateTime?
  expiresAt           DateTime?
  lastActivityAt      DateTime              @default(now())
  timeSpent           Int                   @default(0)
  totalCorrect        Int?
  totalSkipped        Int?
  totalWrong          Int?
  rawScore            Int?
  scaledScore         Int?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     Exam                     @relation(fields: [examId], references: [id], onDelete: Cascade)
  sections RwModuleSectionSession[]

  @@index([userId, status])
  @@index([examId])
  @@index([userId, startedAt])
}

model RwModuleSectionSession {
  id                String               @id @default(cuid())
  rwModuleSessionId String
  examSectionId     String
  status            SectionSessionStatus @default(NOT_STARTED)
  startedAt         DateTime?
  completedAt       DateTime?
  timeSpent         Int                  @default(0)
  remainingTime     Int?
  lastActivityAt    DateTime             @default(now())
  rwModuleSession   RwModuleSession      @relation(fields: [rwModuleSessionId], references: [id], onDelete: Cascade)
  examSection       ExamSection          @relation(fields: [examSectionId], references: [id], onDelete: Cascade)
  answers           RwModuleAnswer[]

  @@unique([rwModuleSessionId, examSectionId])
  @@index([rwModuleSessionId])
  @@index([examSectionId])
}

model RwModuleAnswer {
  id                       String                 @id @default(cuid())
  rwModuleSectionSessionId String
  questionId               String
  selectedOptionId         String?
  textAnswer               String?
  isCorrect                Boolean?
  timeSpent                Int                    @default(0)
  isFlagged                Boolean                @default(false)
  answeredAt               DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  rwModuleSectionSession   RwModuleSectionSession @relation(fields: [rwModuleSectionSessionId], references: [id], onDelete: Cascade)
  question                 Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption           Option?                @relation(fields: [selectedOptionId], references: [id])

  @@unique([rwModuleSectionSessionId, questionId])
  @@index([rwModuleSectionSessionId])
  @@index([questionId])
}

model DodoWebhookEvent {
  id          String    @id
  type        String
  status      String    @default("PROCESSING")
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

enum MathModuleSessionStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

enum RwModuleSessionStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

enum SectionSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum BankPurpose {
  PRACTICE
  FULL_TEST
  MIXED
}

enum FullTestStatus {
  IN_PROGRESS
  BREAK
  COMPLETED
  EXPIRED
}

enum FullTestSectionStatus {
  IN_PROGRESS
  NOT_STARTED
  COMPLETED
  EXPIRED
}

enum Genders {
  MALE
  FEMALE
  OTHERS
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  VIP
}

enum QuestionType {
  MCQ
  GRID_IN
}

enum Subject {
  SAT_MATH
  SAT_RW
  SAT_PRECALCULUS
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttempStatus {
  IN_PROGRESS
  DONE
  EXPIRED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum PracticeStatus {
  IN_PROGRESS
  DONE
  ABANDONED
}

enum PracticeMode {
  ALL_LEVEL
  EASY
  MEDIUM
  HARD
}
